<dialog id="square-info-dialog" class="square-info-dialog" aria-labelledby="square-info-title">
  <div class="square-info-inner">
    <button type="button" class="square-info-close" aria-label="Close" id="square-info-close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M2 2 L12 12 M12 2 L2 12"/>
      </svg>
    </button>
    <div class="square-info-mark">
      <img src="{{ '/resources/img/square-logo-black.svg' | url }}" alt="Square" />
    </div>
    <h2 id="square-info-title">You'll connect your Square account next</h2>
    <p>Fundlet uses Square's secure sign-in to link your store. You'll be asked to log in to Square and approve access — it only takes a moment.</p>
    <a class="btn btn-primary square-info-cta" href="https://raise.fundlet.app">Continue to Square</a>
    <button type="button" class="square-info-cancel" id="square-info-cancel">Cancel</button>
  </div>
</dialog>

<script>
  (function(){
    var dialog = document.getElementById('square-info-dialog');
    if(!dialog || typeof dialog.showModal !== 'function') return;
    document.addEventListener('click', function(e){
      var trigger = e.target.closest('[data-square-info]');
      if(trigger){
        e.preventDefault();
        var ad = document.getElementById('add-dropdown');
        if(ad){ ad.classList.remove('open'); var t = document.getElementById('add-trigger'); if(t) t.setAttribute('aria-expanded','false'); }
        var mm = document.getElementById('mobile-menu');
        if(mm) mm.classList.remove('active');
        var pp = document.getElementById('platform-picker');
        if(pp && pp.open) pp.close();
        dialog.showModal();
      }
    });
    document.getElementById('square-info-close').addEventListener('click', function(){ dialog.close(); });
    document.getElementById('square-info-cancel').addEventListener('click', function(){ dialog.close(); });
    dialog.addEventListener('click', function(e){ if(e.target === dialog) dialog.close(); });
  })();
</script>
