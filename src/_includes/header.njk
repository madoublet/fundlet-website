    <button id="toggle-mobile-menu" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="0" y1="1" x2="20" y2="1"/>
        <line x1="0" y1="7" x2="20" y2="7"/>
        <line x1="0" y1="13" x2="20" y2="13"/>
