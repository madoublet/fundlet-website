<div id="mobile-menu">
  <a href="{{ '/' | url }}">Home</a>
  <a href="{{ '/#how' | url }}">How it works</a>
  <a href="{{ '/#features' | url }}">Features</a>
  <a href="{{ '/#reviews' | url }}">Reviews</a>
  <a href="{{ '/faq' | url }}">FAQ</a>
  <a href="{{ '/learn' | url }}">Learn</a>
  <a href="{{ '/pricing' | url }}">Pricing</a>
  <a class="mobile-cta" href="https://apps.shopify.com/fundlet">Add to Shopify Store</a>
</div>

<script>
  (function(){
    var btn = document.getElementById('toggle-mobile-menu');
    var menu = document.getElementById('mobile-menu');
    btn.addEventListener('click', function(){ menu.classList.toggle('active'); });
    document.addEventListener('click', function(e){
      if(!btn.contains(e.target) && !menu.contains(e.target)) menu.classList.remove('active');
    });

  })();
</script>
