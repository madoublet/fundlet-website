---
title: Base
---
<!DOCTYPE html>
<html lang="en">
<head>
{%- set pageCss = "page.css" -%}
{%- set schemaType = "howto" if "/learn/" in page.url else false -%}
{% include "head.njk" %}
</head>

<body>

{% include "header.njk" %}

<section class="page-intro">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Fundlet</span>
      <h1>{{ title }}</h1>
      {% if description %}<p class="lede">{{ description }}</p>{% endif %}
    </div>
  </div>
</section>

<div class="page-container">
  <div class="page-content">
    {{ content | safe }}
  </div>
</div>

{% include "footer.njk" %}

</body>
</html>
