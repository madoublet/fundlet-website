---
title: Base
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Fundlet — {{ title }}</title>
        <meta name="description" content="{{ description }}" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

        <link rel="icon" href="{{ '/resources/img/favicon.png' | url }}" />
        <link rel="stylesheet" href="{{ '/resources/css/reset.css' | url }}" />
        <link rel="stylesheet" href="{{ '/resources/css/brand.css' | url }}" />
        <link rel="stylesheet" href="{{ '/resources/css/site.css' | url }}" />
        <link rel="stylesheet" href="{{ '/resources/css/page.css' | url }}" />
    </head>
    <body>
        {% include "header.njk" %}
        <section class="page-intro">
            <div class="wrap">
                <div class="sec-head">
                    <span class="eyebrow">Tutorials</span>
                    <h1>{{ title }}</h1>
                    {% if description %}<p class="lede">{{ description }}</p>{% endif %}
                </div>
            </div>
        </section>
        <div class="page-one-column">

            <div class="page-feature">
                <div>
                    <h2>Fundlet for Square Walkthrough</h2>
                    <p>A step-by-step walkthrough of Fundlet for Square — from logging in to launching your first fundraiser.</p>
                    <p>
                        <ul>
                            <li><span>•</span> Log in and connect your Square account</li>
                            <li><span>•</span> Set up your first fundraiser from scratch</li>
                            <li><span>•</span> Tour the campaign page your supporters see</li>
                        </ul>
                    </p>
                    <p><a href="/learn/square/create-your-first-campaign">Read the guide &rarr;</a></p>
                </div>
                <div>
                    <iframe
                        width="940"
                        height="600"
                        src="https://www.youtube.com/embed/DTxuQSTKu3s"
                        title="Create fundraisers for your Square shop with Fundlet"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen></iframe>
                </div>
            </div>

        </div>
        <!-- /page-one-column -->

        {% include "footer.njk" %}
    </body>
</html>
