---
title: Base
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Fundlet — {{ title }}</title>
  <meta name="description" content="{{ description }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="icon" href="{{ '/resources/img/favicon.png' | url }}" />
  <link rel="stylesheet" href="{{ '/resources/css/reset.css' | url }}" />
  <link rel="stylesheet" href="{{ '/resources/css/brand.css' | url }}" />
  <link rel="stylesheet" href="{{ '/resources/css/site.css' | url }}" />
  <link rel="stylesheet" href="{{ '/resources/css/pricing.css' | url }}" />
  <link rel="stylesheet" href="{{ '/resources/css/design-services.css' | url }}" />
</head>

<body>

{% include "header.njk" %}

<section class="pricing-intro">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Fundlet</span>
      <h1>{{ title }}</h1>
      <p class="lede">{{ description }}</p>
      <span class="pricing-trial-note">Free trial available — no credit card required to start</span>
    </div>
  </div>
</section>

<div class="pricing-section">
  <div class="wrap">

    <div class="pricing-grid">

      <!-- Grow -->
      <div class="pricing-card">
        <div class="pricing-card-top">
          <div class="pricing-plan-name">Grow</div>
          <div class="pricing-price"><span class="pricing-amount">$19</span><span class="pricing-per">/ month</span></div>
          <p class="pricing-tagline">For growing fundraisers.</p>
          <ul class="pricing-features">
            <li>Unlimited campaigns</li>
            <li>Average $5,000 in sales per month</li>
            <li>No additional usage fees</li>
            <li>Guaranteed setup</li>
          </ul>
        </div>
        <button class="pricing-cta btn btn-primary" data-platform-picker>Start Grow</button>
      </div>

      <!-- Pro -->
      <div class="pricing-card">
        <div class="pricing-card-top">
          <div class="pricing-plan-name">Pro</div>
          <div class="pricing-price"><span class="pricing-amount">$49</span><span class="pricing-per">/ month</span></div>
          <p class="pricing-tagline">For larger fundraisers with sustained volume.</p>
          <ul class="pricing-features">
            <li>Unlimited campaigns</li>
            <li>Average $15,000 in sales per month</li>
            <li>No additional usage fees</li>
            <li>Priority support</li>
          </ul>
        </div>
        <button class="pricing-cta btn btn-primary" data-platform-picker>Start Pro</button>
      </div>

      <!-- Premium -->
      <div class="pricing-card">
        <div class="pricing-card-top">
          <div class="pricing-plan-name">Premium</div>
          <div class="pricing-price"><span class="pricing-amount">$99</span><span class="pricing-per">/ month</span></div>
          <p class="pricing-tagline">For established fundraisers with high volume.</p>
          <ul class="pricing-features">
            <li>Unlimited campaigns</li>
            <li>Average $50,000 in sales per month</li>
            <li>No additional usage fees</li>
            <li>Priority support</li>
          </ul>
        </div>
        <button class="pricing-cta btn btn-primary" data-platform-picker>Start Premium</button>
      </div>

      <!-- Unlimited -->
      <div class="pricing-card">
        <div class="pricing-card-top">
          <div class="pricing-plan-name">Unlimited</div>
          <div class="pricing-price"><span class="pricing-amount">$299</span><span class="pricing-per">/ month</span></div>
          <p class="pricing-tagline">For teams running at scale.</p>
          <ul class="pricing-features">
            <li>No revenue cap</li>
            <li>Unlimited campaigns</li>
            <li>Customized onboarding</li>
            <li>Design customization included</li>
          </ul>
        </div>
        <button class="pricing-cta btn btn-primary" data-platform-picker>Start Unlimited</button>
      </div>

    </div>

    <p class="pricing-footer-note">Questions about billing? Email <a href="mailto:matt@matthewsmith.com">matt@matthewsmith.com</a>.</p>

  </div>
</div>

<!-- Design Services callout -->
<div class="ds-callout">
  <div class="wrap">
    <div class="ds-callout-inner">
      <div class="ds-callout-text">
        <h2>Need help getting set up?</h2>
        <p>We offer done-for-you setup and full website overhaul services starting at $399. Get your fundraising store live fast, without the headache.</p>
      </div>
      <div class="ds-callout-cta">
        <a class="btn btn-primary" href="{{ '/design-services' | url }}">View Design Services</a>
      </div>
    </div>
  </div>
</div>

<!-- Platform picker dialog -->
<dialog id="platform-picker" class="platform-dialog" aria-labelledby="platform-picker-title">
  <div class="platform-dialog-inner">
    <button type="button" class="platform-dialog-close" aria-label="Close" id="platform-picker-close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M2 2 L12 12 M12 2 L2 12"/>
      </svg>
    </button>
    <h2 id="platform-picker-title">Where's your store?</h2>
    <p>Choose your platform to get started.</p>
    <div class="platform-options">
      <a class="platform-option" href="https://apps.shopify.com/fundlet">
        <svg class="platform-option-mark" viewBox="0 0 109.5 124.5" fill="currentColor" aria-hidden="true">
          <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
          <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2V123.9z"/>
        </svg>
        <span>Add to Shopify Store</span>
      </a>
      <a class="platform-option" href="https://raise.fundlet.app" data-square-info>
        <img class="platform-option-sq" src="{{ '/resources/img/square-logo-black.svg' | url }}" alt="" />
        <span>Add to Square Store</span>
      </a>
    </div>
  </div>
</dialog>

<script>
  (function(){
    var dialog = document.getElementById('platform-picker');
    if(!dialog || typeof dialog.showModal !== 'function') return;
    document.querySelectorAll('[data-platform-picker]').forEach(function(btn){
      btn.addEventListener('click', function(){ dialog.showModal(); });
    });
    document.getElementById('platform-picker-close').addEventListener('click', function(){ dialog.close(); });
    dialog.addEventListener('click', function(e){ if(e.target === dialog) dialog.close(); });
  })();
</script>

{% include "footer.njk" %}

</body>
</html>
