---
title: Base
---
<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
{%- set pageCss = ["index.css", "page.css"] -%}
{%- set seoTitle = title + ' | Fundlet for Shopify' -%}
{% include "head.njk" %}
</head>

<body>

{% include "header.njk" %}

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="ambient"></div>
    <div class="silo"></div>
  </div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text">
        <span class="eyebrow">Fundraising for Shopify &amp; Square</span>
        <h1>{{ title }}</h1>
        <p class="lede">Run fundraisers directly from your own store. Your products, your checkout, your customers — with every sale tracked by campaign and participant. Set up in minutes, no code.</p>
      </div>
      <div class="hero-visual">
        <div class="shot">
          <img src="{{ '/resources/img/popup-shop.png' | url }}" alt="A Fundlet campaign page running on a Shopify store" style="aspect-ratio:4/3;width:100%;object-fit:cover;object-position:top center;" />
        </div>
      </div>
    </div>

    <div class="hero-foot">
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://apps.shopify.com/fundlet">
          <svg class="sh" viewBox="0 0 109.5 124.5" fill="currentColor" aria-hidden="true">
            <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
            <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2V123.9z"/>
          </svg>
          Add to Shopify Store
        </a>
        <a class="btn btn-primary" href="https://raise.fundlet.app" data-square-info>
          <img class="sq" src="{{ '/resources/img/square-logo-white.svg' | url }}" alt="" />
          Add to Square Store
        </a>
        <a class="btn btn-ghost" href="#details">Read the details</a>
      </div>
      <div class="hero-meta">
        <div class="m"><b>5 Minutes</b><span>Setup time</span></div>
        <div class="m"><b>{{ site.rating.value }} ★</b><span>App store · {{ site.rating.ratingCount }} reviews</span></div>
        <div class="m"><b>Unlimited</b><span>Fundraisers at once</span></div>
        <div class="m"><b>1 link</b><span>Per fundraiser</span></div>
        <div class="m"><b>Any org</b><span>Schools, teams &amp; churches</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section class="block">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">What's inside</span>
      <h2>Everything the fundraiser needs, inside the store you already run.</h2>
    </div>

    <div class="feature">
      <div class="feature-text">
        <span class="feature-num">01 — Built into Shopify</span>
        <h3>No separate platform.</h3>
        <p>Fundlet runs entirely inside your existing store, so your fundraiser lives where your products already are — no extra logins, no second checkout.</p>
        <ul>
          <li>Installs in one click from the Shopify App Store</li>
          <li>Uses your existing products and collections</li>
          <li>Works with any Shopify theme</li>
        </ul>
      </div>
      <div class="shot">
        <img src="{{ '/resources/img/fundlet-landing-page.webp' | url }}" alt="A Fundlet campaign page" style="aspect-ratio:4/3;width:100%;object-fit:cover;object-position:top center;" />
      </div>
    </div>

    <div class="feature">
      <div class="feature-text">
        <span class="feature-num">02 — Simple onboarding</span>
        <h3>One link. Zero spreadsheets.</h3>
        <p>Get campaigns and participants set up fast with built-in onboarding forms — no manual spreadsheets or external tools required.</p>
        <ul>
          <li>Add campaigns directly from your Shopify homepage</li>
          <li>Share a single link to onboard participants</li>
          <li>Works on any device</li>
        </ul>
      </div>
      <div class="shot">
        <img src="{{ '/resources/img/fundlet-onboarding.webp' | url }}" alt="Fundlet onboarding form" style="aspect-ratio:4/3;width:100%;object-fit:cover;object-position:top center;" />
      </div>
    </div>

    <div class="feature">
      <div class="feature-text">
        <span class="feature-num">03 — Sales tracking</span>
        <h3>Every sale, automatically tracked.</h3>
        <p>Know exactly how your fundraiser is performing with per-campaign and per-participant reporting built into your Shopify admin.</p>
        <ul>
          <li>Dashboard to track progress toward goals</li>
          <li>Track sales down to the individual participant</li>
          <li>Exportable reports</li>
        </ul>
      </div>
      <div class="shot">
        <img src="{{ '/resources/img/fundlet-tracking.webp' | url }}" alt="Fundlet tracking dashboard" style="aspect-ratio:4/3;width:100%;object-fit:cover;object-position:top center;" />
      </div>
    </div>
  </div>
</section>

<!-- ===== REVIEW ===== -->
<section class="block tint">
  <div class="wrap">
    <div class="review feature-review">
      <span class="tag">Popus Gourmet Popcorn</span>
      <div class="stars">★★★★★</div>
      <p>THIS IS THE BEST!!! Mathew is SUPER responsive! We launched our initiative and raised over $11,000 in less than a week! It works great, highly customizable. Self contained in house fundraising has never been easier. Especially if you are a shop and need to host multiple fundraisers.</p>
      <div class="who"><b>Popus Gourmet Popcorn</b>Shopify App Store · United States</div>
    </div>
  </div>
</section>

<!-- ===== PAGE CONTENT ===== -->
<section class="block" id="details">
  <div class="wrap">
    <div class="page-content">
      {{ content | safe }}
    </div>
  </div>
</section>

<!-- ===== FINAL CTA ===== -->
<section class="cta-band">
  <div class="wrap">
    <div class="cta-inner">
      <span class="eyebrow plain" style="color:var(--on-panel-2)">Get started</span>
      <h2>Launch your first fundraiser this afternoon.</h2>
      <p>Install Fundlet on the store you already run and start your first campaign today.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://apps.shopify.com/fundlet">
          <svg class="sh" viewBox="0 0 109.5 124.5" fill="currentColor" aria-hidden="true">
            <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
            <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2V123.9z"/>
          </svg>
          Add to Shopify Store
        </a>
        <a class="btn btn-primary" href="https://raise.fundlet.app" data-square-info>
          <img class="sq" src="{{ '/resources/img/square-logo-green.svg' | url }}" alt="" />
          Add to Square Store
        </a>
        <a class="btn btn-ghost" href="{{ '/contact' | url }}">Free 30-min consultation</a>
      </div>
    </div>
  </div>
</section>

{% include "footer.njk" %}

</body>

<script src="{{ '/resources/js/app.js' | url }}"></script>

</html>
